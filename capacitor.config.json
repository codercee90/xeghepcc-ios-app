{
  "appId": "cc.xeghep.www.ios",
  "appName": "XeGhep.CC",
  "webDir": "dist",
  "plugins": {
    "BackgroundGeolocation": {
      "backgroundMessage": "Đang cập nhật vị trí hành trình cho khách...",
      "backgroundTitle": "XeGhep.CC đang chạy ngầm"
    },
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#F2F2F7",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "androidSplashResourceName": "splash",
      "iosScaleType": "small",
      "splashFullScreen": false,
      "splashImmersive": false
    }
  },
  "server": {
    "url": "https://www.xeghep.cc/native.php?fromNativeApp=1&fromApp=iosCapacitor",
    "cleartext": true
  }
}
